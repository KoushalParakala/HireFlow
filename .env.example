NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional legacy fallback
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_.
# Use the rotated secret / service_role from Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
WORKER_SECRET=generate-with-openssl-rand-hex-32
# Optional. Vercel Cron sends Authorization: Bearer CRON_SECRET to GET /api/worker/tick.
# CRON_SECRET=
# fake = canned JD/questions for smoke only. Product runs on real.
PROVIDER_MODE=real

GROQ_API_KEY=
GROQ_MODEL_SMART=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Phase 4+
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sourcing. GitHub project search. A fine-grained token with zero permissions
# lifts GitHub from 60 core calls/hour to 5,000 and search from 10/min to 30/min.
GITHUB_TOKEN=

# LinkedIn sourcing via Apify. People search uses Google (`apify/google-search-scraper`),
# then full profiles use apimaestro/linkedin-profile-detail (~$0.005/profile).
# Create a token at https://console.apify.com/settings/integrations
APIFY_TOKEN=
# APIFY_LINKEDIN_ACTOR=apimaestro/linkedin-profile-detail
# APIFY_GOOGLE_SEARCH_ACTOR=apify/google-search-scraper
